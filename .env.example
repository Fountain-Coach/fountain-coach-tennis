# Public origin of the independently hosted application.
BASE_URL=https://tennis.example.invalid

# GitHub OAuth: create this application under the operating owner's account.
OAUTH_IDP=github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://tennis.example.invalid/auth/github/callback

# Server-only session and application configuration.
SESSION_SECRET=
# Transitional local development default is JSON; production migration target is SQLite.
TENNIS_STATE_BACKEND=sqlite
TENNIS_STATE_FILE=/var/lib/tennis/tennis-state.json
TENNIS_SQLITE_FILE=/var/lib/tennis/tennis.sqlite
TENNIS_AUDIT_FILE=/var/lib/tennis/audit.jsonl
TENNIS_ADMIN_EMAILS=
CORS_ORIGINS=https://tennis.example.invalid
NODE_ENV=production

# Optional MCP/native bridge configuration. Keep all values server-side.
MCP_BEARER_TOKEN=
TENNIS_NATIVE_BRIDGE_URL=
TENNIS_NATIVE_TENANT_ID=
TENNIS_NATIVE_USER_ID=
TENNIS_NATIVE_BEARER_TOKEN=
